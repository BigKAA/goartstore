      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(se_operations_total{namespace=\"$namespace\", instance=~\"$instance\"}[$interval])) by (operation, result)",
          "legendFormat": "{{operation}}:{{result}}",
