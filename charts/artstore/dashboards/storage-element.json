        {
          "expr": "histogram_quantile(0.95, sum(rate(se_http_request_duration_seconds_bucket{namespace=\"$namespace\", instance=~\"$instance\"}[$interval])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
