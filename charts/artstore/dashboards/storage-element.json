          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(se_reconcile_duration_seconds_bucket{namespace=\"$namespace\", instance=~\"$instance\"}[$interval])) by (le))",
          "legendFormat": "Reconcile p95",
          "refId": "B"
        }
