        {
          "expr": "histogram_quantile(0.99, sum(rate(se_http_request_duration_seconds_bucket{namespace=\"$namespace\", instance=~\"$instance\"}[$interval])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
