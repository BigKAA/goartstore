{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Artstore Overview: System Health, Request Rate, Latency, Error Rate, Storage",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "System Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Admin Module",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=~\".*admin-module.*\", namespace=\"$namespace\"}",
          "legendFormat": "Admin Module",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Ingester Module",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=~\".*ingester-module.*\", namespace=\"$namespace\"}",
          "legendFormat": "Ingester Module",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Query Module",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=~\".*query-module.*\", namespace=\"$namespace\"}",
          "legendFormat": "Query Module",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Storage Elements",
      "type": "stat",
      "targets": [
        {
          "expr": "count(up{job=~\".*storage-element.*\", namespace=\"$namespace\"} == 1)",
          "legendFormat": "SE Healthy",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Dependency Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "displayMode": "color-background",
            "filterable": false,
            "inspect": false
          },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "FAIL" }, "1": { "color": "green", "text": "OK" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Health" }]
      },
      "title": "Dependency Health Matrix",
      "type": "table",
      "targets": [
        {
          "expr": "app_dependency_health{namespace=\"$namespace\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "namespace": true },
            "renameByName": { "group": "Group", "name": "Service", "target": "Target", "Value": "Health" }
          }
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 102,
      "title": "Request Rate",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "req/s",
            "fillOpacity": 30,
            "lineWidth": 1,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Request Rate (stacked by module)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(am_http_requests_total{namespace=\"$namespace\"}[$interval]))",
          "legendFormat": "Admin Module",
          "refId": "A"
        },
        {
          "expr": "sum(rate(im_http_requests_total{namespace=\"$namespace\"}[$interval]))",
          "legendFormat": "Ingester Module",
          "refId": "B"
        },
        {
          "expr": "sum(rate(qm_http_requests_total{namespace=\"$namespace\"}[$interval]))",
          "legendFormat": "Query Module",
          "refId": "C"
        },
        {
          "expr": "sum(rate(se_http_requests_total{namespace=\"$namespace\"}[$interval]))",
          "legendFormat": "Storage Element",
          "refId": "D"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "%",
            "fillOpacity": 10,
            "lineWidth": 2,
            "thresholdsStyle": { "mode": "line" }
          },
          "max": 100,
          "min": 0,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Error Rate (% 5xx)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 * sum(rate(am_http_requests_total{namespace=\"$namespace\", status=~\"5..\"}[$interval])) / sum(rate(am_http_requests_total{namespace=\"$namespace\"}[$interval]))",
          "legendFormat": "Admin Module",
          "refId": "A"
        },
        {
          "expr": "100 * sum(rate(im_http_requests_total{namespace=\"$namespace\", status=~\"5..\"}[$interval])) / sum(rate(im_http_requests_total{namespace=\"$namespace\"}[$interval]))",
          "legendFormat": "Ingester Module",
          "refId": "B"
        },
        {
          "expr": "100 * sum(rate(qm_http_requests_total{namespace=\"$namespace\", status=~\"5..\"}[$interval])) / sum(rate(qm_http_requests_total{namespace=\"$namespace\"}[$interval]))",
          "legendFormat": "Query Module",
          "refId": "C"
        },
        {
          "expr": "100 * sum(rate(se_http_requests_total{namespace=\"$namespace\", status=~\"5..\"}[$interval])) / sum(rate(se_http_requests_total{namespace=\"$namespace\"}[$interval]))",
          "legendFormat": "Storage Element",
          "refId": "D"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 103,
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "",
            "fillOpacity": 0,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 22 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Latency p50",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(am_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[$interval])) by (le))",
          "legendFormat": "Admin Module",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(im_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[$interval])) by (le))",
          "legendFormat": "Ingester Module",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(qm_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[$interval])) by (le))",
          "legendFormat": "Query Module",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(se_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[$interval])) by (le))",
          "legendFormat": "Storage Element",
          "refId": "D"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "",
            "fillOpacity": 0,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 22 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Latency p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(am_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[$interval])) by (le))",
          "legendFormat": "Admin Module",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(im_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[$interval])) by (le))",
          "legendFormat": "Ingester Module",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(qm_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[$interval])) by (le))",
          "legendFormat": "Query Module",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(se_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[$interval])) by (le))",
          "legendFormat": "Storage Element",
          "refId": "D"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "",
            "fillOpacity": 0,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 22 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Latency p99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(am_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[$interval])) by (le))",
          "legendFormat": "Admin Module",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(im_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[$interval])) by (le))",
          "legendFormat": "Ingester Module",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(qm_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[$interval])) by (le))",
          "legendFormat": "Query Module",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(se_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[$interval])) by (le))",
          "legendFormat": "Storage Element",
          "refId": "D"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 104,
      "title": "Storage",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisBorderShow": false, "fillOpacity": 0, "lineWidth": 2 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Files by Status (SE)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(se_files_total{namespace=\"$namespace\", status=\"active\"}) by (status)",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "sum(se_files_total{namespace=\"$namespace\", status=\"deleted\"}) by (status)",
          "legendFormat": "Deleted",
          "refId": "B"
        },
        {
          "expr": "sum(se_files_total{namespace=\"$namespace\", status=\"expired\"}) by (status)",
          "legendFormat": "Expired",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisBorderShow": false, "fillOpacity": 0, "lineWidth": 2 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 31 },
      "id": 12,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Storage Usage (SE)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "se_storage_bytes{namespace=\"$namespace\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisBorderShow": false, "fillOpacity": 30, "lineWidth": 1, "stacking": { "group": "A", "mode": "normal" } },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 31 },
      "id": 13,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "SE Operations (stacked)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(se_operations_total{namespace=\"$namespace\", operation=\"upload\"}[$interval])) by (operation)",
          "legendFormat": "Upload",
          "refId": "A"
        },
        {
          "expr": "sum(rate(se_operations_total{namespace=\"$namespace\", operation=\"download\"}[$interval])) by (operation)",
          "legendFormat": "Download",
          "refId": "B"
        },
        {
          "expr": "sum(rate(se_operations_total{namespace=\"$namespace\", operation=\"delete\"}[$interval])) by (operation)",
          "legendFormat": "Delete",
          "refId": "C"
        },
        {
          "expr": "sum(rate(se_operations_total{namespace=\"$namespace\", operation=\"update\"}[$interval])) by (operation)",
          "legendFormat": "Update",
          "refId": "D"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["artstore"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
