package layouts

import "github.com/bigkaa/goartstore/demo-client/internal/ui/i18n"

// PageParams — параметры обёртки страницы
type PageParams struct {
	Title     string // Заголовок страницы (h1)
	ActiveNav string // Активный пункт навигации (для sidebar)
}

// Page — обёртка страницы: sidebar + header + content area.
// Используется внутри Base layout. Demo Client не имеет аутентификации пользователей
// (работает через SA), поэтому нет Username/Role.
templ Page(params PageParams) {
	@Base(BaseParams{Title: params.Title}) {
		<!-- Sidebar (fixed left) -->
		@Sidebar(SidebarParams{ActiveNav: params.ActiveNav})

		<!-- Основная область контента -->
		<div class="flex-1 flex flex-col min-h-screen lg:ml-64">
			<!-- Header -->
			@Header(HeaderParams{Title: params.Title})

			<!-- Контент страницы -->
			<main class="flex-1 p-6 overflow-auto">
				{ children... }
			</main>

			<!-- Footer с версией -->
			<footer class="px-6 py-3 border-t border-border-subtle text-center">
				<p class="text-xs text-text-muted">{ i18n.T(ctx, "app.version") }</p>
			</footer>
		</div>
	}
}
