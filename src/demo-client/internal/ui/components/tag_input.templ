package components

import (
	"context"

	"github.com/bigkaa/goartstore/demo-client/internal/ui/i18n"
)

// TagInputParams — параметры компонента ввода тегов
type TagInputParams struct {
	Name        string   // Имя поля формы
	Placeholder string   // Placeholder
	Tags        []string // Предзаполненные теги
}

// TagInput — компонент ввода тегов с чипами.
// Использует Alpine.js для динамического добавления/удаления тегов.
// Значения хранятся в скрытом поле через запятую.
templ TagInput(params TagInputParams) {
	<div
		x-data={ tagInputInitData(params.Tags) }
		class="space-y-2"
	>
		<!-- Скрытое поле с тегами (для отправки формы) -->
		<input type="hidden" name={ params.Name } x-bind:value="tags.join(',')"/>

		<!-- Поле ввода нового тега -->
		<div class="flex items-center gap-2">
			<input
				type="text"
				x-model="newTag"
				x-on:keydown.enter.prevent="addTag()"
				x-on:keydown.comma.prevent="addTag()"
				placeholder={ tagPlaceholder(params.Placeholder, ctx) }
				class="input-field flex-1"
			/>
			<button
				type="button"
				x-on:click="addTag()"
				class="px-3 py-2 text-sm rounded-button bg-bg-elevated text-text-secondary hover:text-text-primary hover:bg-bg-hover transition-colors"
			>
				+
			</button>
		</div>

		<!-- Чипы тегов -->
		<div class="flex flex-wrap gap-2" x-show="tags.length > 0">
			<template x-for="(tag, index) in tags" :key="index">
				<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-accent-primary/10 text-accent-primary">
					<span x-text="tag"></span>
					<button
						type="button"
						x-on:click="removeTag(index)"
						class="ml-1.5 text-accent-primary/60 hover:text-accent-primary transition-colors"
					>
						<svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</span>
			</template>
		</div>
	</div>
}

// tagInputInitData — Alpine.js x-data инициализация для компонента тегов
func tagInputInitData(tags []string) string {
	if len(tags) == 0 {
		return `{
			tags: [],
			newTag: '',
			addTag() {
				let tag = this.newTag.trim();
				if (tag && !this.tags.includes(tag)) {
					this.tags.push(tag);
				}
				this.newTag = '';
			},
			removeTag(index) {
				this.tags.splice(index, 1);
			}
		}`
	}

	// Формируем JSON-массив тегов
	tagsJSON := "["
	for i, tag := range tags {
		if i > 0 {
			tagsJSON += ","
		}
		tagsJSON += "'" + tag + "'"
	}
	tagsJSON += "]"

	return `{
		tags: ` + tagsJSON + `,
		newTag: '',
		addTag() {
			let tag = this.newTag.trim();
			if (tag && !this.tags.includes(tag)) {
				this.tags.push(tag);
			}
			this.newTag = '';
		},
		removeTag(index) {
			this.tags.splice(index, 1);
		}
	}`
}

// tagPlaceholder — placeholder для поля ввода тега
func tagPlaceholder(placeholder string, ctx context.Context) string {
	if placeholder != "" {
		return placeholder
	}
	return i18n.T(ctx, "upload.tags_placeholder")
}
