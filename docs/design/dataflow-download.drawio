<mxfile host="Claude Code" modified="2026-03-03T12:00:00.000Z" agent="Claude Code" version="24.0.0" etag="dataflow-download-v1" type="device">
  <diagram id="dataflow-download" name="Data Flow — File Download">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Заголовок -->
        <mxCell id="title" value="&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Data Flow: File Download&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Client → API Gateway → Query Module → Admin Module → Storage Element → Client&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="350" y="10" width="600" height="50" as="geometry" />
        </mxCell>

        <!-- ==================== УЧАСТНИКИ ==================== -->

        <mxCell id="client" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Client&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;Разработчик / Система&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="330" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="gateway" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;API Gateway&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;Envoy, TLS, JWT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="280" y="330" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="query" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Query Module&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;LRU cache, proxy download&lt;br&gt;Range requests, hard delete при 404&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="540" y="310" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="admin" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Admin Module&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;File + SE lookup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="860" y="200" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="se" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Storage Element&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;File streaming&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="860" y="440" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="postgresql" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="600" y="130" width="100" height="55" as="geometry" />
        </mxCell>

        <mxCell id="cache" value="&lt;b&gt;LRU Cache&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;In-memory, TTL 30-60s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;arcSize=8;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="400" y="160" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- ==================== ПОТОКИ ==================== -->

        <!-- 1: Client → Gateway -->
        <mxCell id="flow1" value="&lt;b&gt;1&lt;/b&gt; GET /query/files/{id}/download&lt;br&gt;&lt;i&gt;JWT + Range header (опц.)&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;" parent="1" source="client" target="gateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2: Gateway → QM -->
        <mxCell id="flow2" value="&lt;b&gt;2&lt;/b&gt; Forward" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;" parent="1" source="gateway" target="query" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3: QM → Cache check -->
        <mxCell id="flow3" value="&lt;b&gt;3&lt;/b&gt; Cache check" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;" parent="1" source="query" target="cache" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4a: QM → PG (cache miss) -->
        <mxCell id="flow4a" value="&lt;b&gt;4a&lt;/b&gt; Cache MISS → SELECT file_registry" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;dashed=1;" parent="1" source="query" target="postgresql" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5: QM → AM (SE info) -->
        <mxCell id="flow5" value="&lt;b&gt;5&lt;/b&gt; GET /storage-elements/{se_id}&lt;br&gt;&lt;i&gt;URL + credentials&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="query" target="admin" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6: QM → SE (download) -->
        <mxCell id="flow6" value="&lt;b&gt;6&lt;/b&gt; GET /files/{id}/download&lt;br&gt;&lt;i&gt;SA JWT, Range (опц.)&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="query" target="se" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 7: Response stream -->
        <mxCell id="flow7" value="&lt;b&gt;7&lt;/b&gt; 200 OK + binary stream&lt;br&gt;&lt;i&gt;Content-Type, Content-Length&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;dashed=1;dashPattern=5 5;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="query" target="client" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="600" />
              <mxPoint x="120" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== ЗАМЕТКИ ==================== -->

        <mxCell id="note_lazy" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;Hard Delete при 404:&lt;/b&gt;&lt;br&gt;Если SE вернул 404:&lt;br&gt;→ DELETE /files/{id} через AM&lt;br&gt;→ DELETE FROM file_registry&lt;br&gt;→ Инвалидация кэша&lt;br&gt;→ Вернуть 404 клиенту&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="1100" y="340" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note_cache" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;Cache Strategy:&lt;/b&gt;&lt;br&gt;• golang-lru/v2 (expirable)&lt;br&gt;• TTL: 30-60s&lt;br&gt;• Key: file_id&lt;br&gt;• Value: FileInfo + SE URL&lt;br&gt;• Cache HIT → skip steps 4a, 5&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="1100" y="140" width="200" height="100" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
