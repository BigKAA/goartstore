        <mxCell id="note_pkce" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;PKCE (Proof Key for Code Exchange):&lt;/b&gt;&lt;br&gt;• code_verifier: random 128 bytes&lt;br&gt;• code_challenge: SHA256(code_verifier)&lt;br&gt;• Защита от code interception&lt;br&gt;• Обязателен для public clients&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
