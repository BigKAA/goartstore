        <!-- ==================== ЗАМЕТКИ ==================== -->

        <mxCell id="note_jwt" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;JWT Claims:&lt;/b&gt;&lt;br&gt;• sub: user/client ID&lt;br&gt;• realm_access.roles: [admin, readonly]&lt;br&gt;• groups: [artstore-admins]&lt;br&gt;• scope: files:read files:write&lt;br&gt;• &lt;b&gt;client_id&lt;/b&gt;: SA identifier (mapper!)&lt;br&gt;• iss, exp, aud&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
