            <Array as="points">
              <mxPoint x="1100" y="1500" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 21. UploadService -> Handler: return UploadResponse -->
        <mxCell id="msg24" value="*UploadResponse" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1060" y="1570" as="sourcePoint" />
            <mxPoint x="895" y="1570" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 22. Handler -> Logging: response -->
        <mxCell id="msg25" value="HTTP 201 + JSON body" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="895" y="1600" as="sourcePoint" />
            <mxPoint x="600" y="1600" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 23. Logging: log request -->
        <mxCell id="msg26" value="slog.Info: method, path,&lt;br&gt;status=201, duration, bytes" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=9;fontColor=#888888;strokeColor=#888888;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="1610" as="sourcePoint" />
            <mxPoint x="600" y="1640" as="targetPoint" />
            <Array as="points">
              <mxPoint x="630" y="1625" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 24. Logging -> Metrics -->
        <mxCell id="msg27" value="" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="1650" as="sourcePoint" />
            <mxPoint x="460" y="1650" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 25. Metrics: record -->
        <mxCell id="msg28" value="im_http_requests_total++&lt;br&gt;im_http_request_duration_seconds.Observe()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=9;fontColor=#888888;strokeColor=#888888;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="1650" as="sourcePoint" />
            <mxPoint x="460" y="1680" as="targetPoint" />
            <Array as="points">
              <mxPoint x="490" y="1665" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 26. Metrics -> Gateway -->
        <mxCell id="msg29" value="" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="1690" as="sourcePoint" />
            <mxPoint x="300" y="1690" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 27. Gateway -> Client: HTTP 201 -->
        <mxCell id="msg30" value="HTTP 201 Created&lt;br&gt;Content-Type: application/json&lt;br&gt;{UploadResponse}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="1720" as="sourcePoint" />
            <mxPoint x="120" y="1720" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Легенда ===== -->
        <mxCell id="legend" value="&lt;b&gt;Легенда:&lt;/b&gt;&lt;br&gt;───── синхронный вызов&lt;br&gt;- - - - возврат/ответ&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;● зелёный — успешный ответ SE (201)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#cc6600&quot;&gt;● оранжевый — retry при 507 Storage Full&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;● красный — ошибка (502 SE_UPLOAD_FAILED)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot;&gt;● серый — observability (логи, метрики)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Pipeline IM (9 шагов):&lt;/b&gt;&lt;br&gt;1. Валидация retention_policy, ttl_days&lt;br&gt;2. Сохранение в temp-file (emptyDir)&lt;br&gt;3. Проверка fileSize ≤ MaxFileSize&lt;br&gt;4. SelectSE (Sequential Fill)&lt;br&gt;5. Seek(0,0) temp-file&lt;br&gt;6. Upload в SE (streaming)&lt;br&gt;7. Retry при 507 (до 3 раз)&lt;br&gt;8. RegisterFile в AM&lt;br&gt;9. Сборка UploadResponse&lt;br&gt;&lt;br&gt;&lt;b&gt;Prometheus метрики:&lt;/b&gt;&lt;br&gt;im_uploads_total, im_upload_duration_seconds,&lt;br&gt;im_active_uploads, im_retry_total,&lt;br&gt;im_se_upload_duration_seconds,&lt;br&gt;im_http_requests_total" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1200" width="310" height="380" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
