        <!-- Note: uploaded_by -->
        <mxCell id="note_upby" value="uploaded_by = sub из JWT&lt;br&gt;конечного пользователя&lt;br&gt;(не SA client_id)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="830" y="1365" width="195" height="50" as="geometry" />
        </mxCell>

        <!-- 19. Admin Module -> UploadService: FileRecord -->
        <mxCell id="msg22" value="201 {file_id, status=active,&lt;br&gt;expires_at}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1400" y="1430" as="sourcePoint" />
            <mxPoint x="1060" y="1430" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 20. UploadService: build response -->
        <mxCell id="msg23" value="Собрать UploadResponse:&lt;br&gt;SE(file_id, checksum, size)&lt;br&gt;+ AM(expires_at) + params&lt;br&gt;im_uploads_total++&lt;br&gt;im_upload_duration_seconds.Observe()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
