  <diagram id="c4-context" name="C4 Context — Artstore">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Заголовок -->
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Artstore — C4 Context Diagram&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666666&quot;&gt;Верхний уровень: система, актёры и внешние зависимости&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="450" y="20" width="500" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== АКТЁРЫ (Persons) ==================== -->

        <!-- Администратор -->
        <mxCell id="person_admin" value="&lt;b&gt;Администратор&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Управляет системой через&lt;br&gt;Admin UI: SE, файлы,&lt;br&gt;сервисные аккаунты&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="200" y="120" width="40" height="60" as="geometry" />
        </mxCell>

        <!-- Разработчик-интегратор -->
        <mxCell id="person_developer" value="&lt;b&gt;Разработчик-интегратор&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Использует API для загрузки,&lt;br&gt;поиска и скачивания файлов&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="700" y="120" width="40" height="60" as="geometry" />
        </mxCell>

        <!-- Внешняя система (API consumer) -->
        <mxCell id="person_api_consumer" value="&lt;b&gt;Внешняя система&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;M2M интеграция:&lt;br&gt;автоматическая загрузка&lt;br&gt;и получение файлов&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="1100" y="120" width="40" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== ОСНОВНАЯ СИСТЕМА ==================== -->

        <!-- Artstore System -->
        <mxCell id="system_artstore" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Artstore&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#333333&quot;&gt;Распределённое файловое хранилище&lt;br&gt;с микросервисной архитектурой.&lt;br&gt;&lt;br&gt;Загрузка, хранение, поиск и&lt;br&gt;скачивание файлов с поддержкой&lt;br&gt;гео-распределённых узлов хранения.&lt;br&gt;&lt;br&gt;&lt;i&gt;Go, REST API, JWT, PostgreSQL&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;arcSize=8;verticalAlign=middle;align=center;fontSize=12;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="480" y="380" width="380" height="220" as="geometry" />
        </mxCell>

        <!-- ==================== ВНЕШНИЕ СИСТЕМЫ ==================== -->

        <!-- Keycloak -->
        <mxCell id="ext_keycloak" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Keycloak&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;Identity Provider (IdP)&lt;br&gt;&lt;br&gt;OAuth 2.0 / OIDC&lt;br&gt;JWT RS256, JWKS&lt;br&gt;Управление пользователями,&lt;br&gt;ролями и группами&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;arcSize=8;verticalAlign=middle;align=center;fontSize=11;dashed=1;dashPattern=5 5;" parent="1" vertex="1">
          <mxGeometry x="100" y="700" width="260" height="160" as="geometry" />
        </mxCell>

        <!-- PostgreSQL -->
        <mxCell id="ext_postgresql" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;PostgreSQL 17&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;Реляционная СУБД&lt;br&gt;&lt;br&gt;Реестр файлов, реестр SE,&lt;br&gt;сервисные аккаунты,&lt;br&gt;полнотекстовый поиск (FTS)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=middle;align=center;fontSize=11;dashed=1;dashPattern=5 5;" parent="1" vertex="1">
          <mxGeometry x="560" y="720" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- Файловое хранилище (NFS/Локальное) -->
        <mxCell id="ext_storage" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Файловое хранилище&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;NFS / Локальный диск / PVC&lt;br&gt;&lt;br&gt;Физическое хранение файлов,&lt;br&gt;attr.json, WAL&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=middle;align=center;fontSize=11;dashed=1;dashPattern=5 5;" parent="1" vertex="1">
          <mxGeometry x="960" y="720" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- ==================== СВЯЗИ ==================== -->

        <!-- Администратор → Artstore (Admin UI) -->
        <mxCell id="rel_admin_artstore" value="Управление системой&lt;br&gt;через Admin UI&lt;br&gt;&lt;i&gt;[HTTPS, JWT]&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;" parent="1" source="person_admin" target="system_artstore" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Разработчик → Artstore (REST API) -->
        <mxCell id="rel_dev_artstore" value="Upload, Search, Download&lt;br&gt;&lt;i&gt;[HTTPS, REST API, JWT]&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;" parent="1" source="person_developer" target="system_artstore" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Внешняя система → Artstore (M2M API) -->
        <mxCell id="rel_api_artstore" value="M2M: Upload, Download&lt;br&gt;&lt;i&gt;[HTTPS, Client Credentials]&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;strokeWidth=2;fontSize=10;" parent="1" source="person_api_consumer" target="system_artstore" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Artstore → Keycloak -->
        <mxCell id="rel_artstore_kc" value="Аутентификация,&lt;br&gt;валидация JWT, JWKS&lt;br&gt;&lt;i&gt;[HTTPS, OIDC]&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=2;fontSize=10;" parent="1" source="system_artstore" target="ext_keycloak" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Artstore → PostgreSQL -->
        <mxCell id="rel_artstore_pg" value="Реестр файлов, SE,&lt;br&gt;полнотекстовый поиск&lt;br&gt;&lt;i&gt;[TCP, pgx/v5]&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#666666;strokeWidth=2;fontSize=10;" parent="1" source="system_artstore" target="ext_postgresql" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Artstore → Файловое хранилище -->
