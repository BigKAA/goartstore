<mxfile host="Claude Code" modified="2026-03-03T12:00:00.000Z" agent="Claude Code" version="24.0.0" etag="dataflow-search-v1" type="device">
  <diagram id="dataflow-search" name="Data Flow — File Search">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Заголовок -->
        <mxCell id="title" value="&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Data Flow: File Search&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Client → API Gateway → Query Module → PostgreSQL FTS&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="350" y="10" width="460" height="50" as="geometry" />
        </mxCell>

        <!-- ==================== УЧАСТНИКИ ==================== -->

        <mxCell id="client" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Client&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;Разработчик / Система&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="300" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="gateway" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;API Gateway&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;Envoy, TLS, JWT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="300" y="300" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="query" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Query Module&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;Search service&lt;br&gt;LRU cache, пагинация&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="580" y="280" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="cache" value="&lt;b&gt;LRU Cache&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;In-memory cache&lt;br&gt;Key: query hash&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;arcSize=8;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="580" y="130" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="postgresql" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;PostgreSQL 17&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333&quot;&gt;file_registry table&lt;br&gt;GIN index: to_tsvector(name||desc)&lt;br&gt;Full-Text Search (FTS)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=middle;align=center;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="920" y="270" width="260" height="130" as="geometry" />
        </mxCell>

        <!-- ==================== ПОТОКИ ==================== -->

        <!-- 1: Client → Gateway -->
        <mxCell id="flow1" value="&lt;b&gt;1&lt;/b&gt; POST /query/search&lt;br&gt;&lt;i&gt;{query, mode, filters, limit, offset}&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;" parent="1" source="client" target="gateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2: Gateway → QM -->
        <mxCell id="flow2" value="&lt;b&gt;2&lt;/b&gt; Forward" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;" parent="1" source="gateway" target="query" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3: QM → Cache -->
        <mxCell id="flow3" value="&lt;b&gt;3&lt;/b&gt; Cache check" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;" parent="1" source="query" target="cache" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4: QM → PostgreSQL -->
        <mxCell id="flow4" value="&lt;b&gt;4&lt;/b&gt; Cache MISS → FTS Query&lt;br&gt;&lt;i&gt;to_tsquery(query)&lt;br&gt;ts_rank() for relevance&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;" parent="1" source="query" target="postgresql" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5: Response -->
        <mxCell id="flow5" value="&lt;b&gt;5&lt;/b&gt; 200 OK&lt;br&gt;&lt;i&gt;{items[], total, limit, offset, has_more}&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;dashed=1;dashPattern=5 5;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="query" target="client" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="520" />
              <mxPoint x="120" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== ЗАМЕТКИ ==================== -->

        <mxCell id="note_modes" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;Режимы поиска:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;fulltext&lt;/b&gt;: to_tsvector + to_tsquery&lt;br&gt;  GIN index, ts_rank() scoring&lt;br&gt;• &lt;b&gt;partial&lt;/b&gt;: ILIKE '%query%'&lt;br&gt;• &lt;b&gt;exact&lt;/b&gt;: name = 'query'&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="920" y="460" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note_filters" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;Фильтры (dynamic WHERE):&lt;/b&gt;&lt;br&gt;• storage_element_id&lt;br&gt;• status (active/deleted)&lt;br&gt;• retention (temporary/permanent)&lt;br&gt;• created_at range&lt;br&gt;• file_size range&lt;br&gt;• content_type&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="920" y="580" width="220" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
