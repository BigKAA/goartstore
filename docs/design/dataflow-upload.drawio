<mxfile host="Claude Code" modified="2026-03-03T12:00:00.000Z" agent="Claude Code" version="24.0.0" etag="dataflow-upload-v1" type="device">
  <diagram id="dataflow-upload" name="Data Flow — File Upload">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Заголовок -->
        <mxCell id="title" value="&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Data Flow: File Upload&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Client → API Gateway → Ingester Module → Storage Element → Admin Module&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="400" y="10" width="560" height="50" as="geometry" />
        </mxCell>

        <!-- ==================== УЧАСТНИКИ ==================== -->

        <!-- Client -->
        <mxCell id="client" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Client&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;Разработчик / Внешняя система&lt;br&gt;curl / SDK / приложение&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="340" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="gateway" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;API Gateway&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;Envoy Gateway&lt;br&gt;TLS, JWT validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="300" y="340" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Ingester Module -->
        <mxCell id="ingester" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Ingester Module&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;Sequential Fill Algorithm&lt;br&gt;Temp-file буферизация&lt;br&gt;Retry на 507&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="540" y="320" width="200" height="120" as="geometry" />
        </mxCell>

        <!-- Admin Module -->
        <mxCell id="admin" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Admin Module&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;Реестр SE и файлов&lt;br&gt;PostgreSQL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="840" y="200" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Storage Element -->
        <mxCell id="se" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Storage Element&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;WAL + attr.json&lt;br&gt;Физическое хранение&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="840" y="460" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Keycloak -->
        <mxCell id="keycloak" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Keycloak&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;Token endpoint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;arcSize=8;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="580" y="120" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- PostgreSQL -->
        <mxCell id="postgresql" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="1120" y="210" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- File System -->
        <mxCell id="filesystem" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Файловая система&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="1120" y="470" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== ПОТОКИ ДАННЫХ ==================== -->

        <!-- 1: Client → Gateway -->
        <mxCell id="flow1" value="&lt;b&gt;1&lt;/b&gt; POST /upload/files&lt;br&gt;&lt;i&gt;multipart/form-data + JWT&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;" parent="1" source="client" target="gateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2: Gateway → Ingester -->
        <mxCell id="flow2" value="&lt;b&gt;2&lt;/b&gt; Forward (validated JWT)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;" parent="1" source="gateway" target="ingester" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3: Ingester → Keycloak (SA token) -->
        <mxCell id="flow3" value="&lt;b&gt;3&lt;/b&gt; SA Token (client_credentials)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;" parent="1" source="ingester" target="keycloak" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4: Ingester → AM (SE list) -->
        <mxCell id="flow4" value="&lt;b&gt;4&lt;/b&gt; GET /storage-elements&lt;br&gt;&lt;i&gt;?mode=edit|rw&amp;amp;status=online&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="ingester" target="admin" edge="1">
          <mxGeometry x="0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 5: Ingester → SE (upload) -->
        <mxCell id="flow5" value="&lt;b&gt;5&lt;/b&gt; POST /files/upload&lt;br&gt;&lt;i&gt;streaming from temp file&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="ingester" target="se" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6: Ingester → AM (register file) -->
        <mxCell id="flow6" value="&lt;b&gt;6&lt;/b&gt; POST /files&lt;br&gt;&lt;i&gt;{file_id, se_id, checksum, size}&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" parent="1" source="ingester" target="admin" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 7: AM → PostgreSQL -->
        <mxCell id="flow7" value="INSERT file_registry" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;strokeWidth=1.5;fontSize=9;endArrow=block;endFill=1;" parent="1" source="admin" target="postgresql" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SE → Filesystem -->
        <mxCell id="flow_se_fs" value="WAL + data + attr.json" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;strokeWidth=1.5;fontSize=9;endArrow=block;endFill=1;" parent="1" source="se" target="filesystem" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== RESPONSE (обратный путь) ==================== -->

        <mxCell id="resp" value="&lt;b&gt;7&lt;/b&gt; 201 Created&lt;br&gt;&lt;i&gt;{file_id, checksum, size, se_id}&lt;/i&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;dashed=1;dashPattern=5 5;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="ingester" target="client" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="600" />
              <mxPoint x="130" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== ЗАМЕТКИ ==================== -->

        <mxCell id="note_retry" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;Retry на 507:&lt;/b&gt;&lt;br&gt;SE storage full → Seek(0,0)&lt;br&gt;→ исключить SE → выбрать другой&lt;br&gt;→ повторить upload (max 3)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="540" y="550" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="note_selection" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;Sequential Fill:&lt;/b&gt;&lt;br&gt;1. Фильтр: mode (edit/rw) + status=online&lt;br&gt;2. Сортировка: priority ASC&lt;br&gt;3. Выбор первого с capacity&lt;br&gt;4. retention=temporary → edit SE&lt;br&gt;   retention=permanent → rw SE&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="1120" y="100" width="260" height="100" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
