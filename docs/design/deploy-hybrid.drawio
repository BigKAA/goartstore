          <mxGeometry x="1190" y="340" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="firewall2" value="&lt;font style=&quot;font-size:10px;color:#b85450&quot;&gt;&lt;b&gt;Firewall&lt;/b&gt;&lt;br&gt;allow: 8010-8019&lt;br&gt;TLS required&lt;/font&gt;" style="shape=mxgraph.cisco.firewalls.firewall;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="1190" y="690" width="40" height="40" as="geometry" />
