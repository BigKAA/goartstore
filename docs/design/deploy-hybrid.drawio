        <mxCell id="se_remote1" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;SE (rw) #1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;Docker container&lt;br&gt;Port: 8010 (exposed)&lt;br&gt;Volume: /data (local SSD)&lt;br&gt;URL: se1.remote-dc.example.com&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="1280" y="300" width="240" height="100" as="geometry" />
        </mxCell>

