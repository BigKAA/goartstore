<mxfile host="Claude Code" modified="2026-03-03T12:00:00.000Z" agent="Claude Code" version="24.0.0" etag="deploy-hybrid-v1" type="device">
  <diagram id="deploy-hybrid" name="Deployment — Hybrid (K8s + Remote SE)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Заголовок -->
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Deployment Diagram: Hybrid (K8s + Remote SE)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666&quot;&gt;Control plane в K8s, Storage Elements как Docker контейнеры в других ЦОД&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="400" y="10" width="600" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== USERS ==================== -->

        <mxCell id="users" value="&lt;b&gt;Пользователи&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666&quot;&gt;Интернет / VPN&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="840" y="90" width="30" height="50" as="geometry" />
        </mxCell>

        <!-- ==================== K8s CLUSTER (Central Data Center) ==================== -->

