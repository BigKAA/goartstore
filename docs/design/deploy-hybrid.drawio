        </mxCell>

        <!-- IM -->
        <mxCell id="im" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Ingester Module&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;Deployment, port 8020&lt;br&gt;Stateless, scalable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;fontSize=10;" parent="1" vertex="1">
