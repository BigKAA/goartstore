        <!-- ==================== СВЯЗИ ==================== -->

        <!-- Users → Gateway -->
        <mxCell id="rel_users" value="HTTPS" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=9;" parent="1" source="users" target="gateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gateway → Modules -->
        <mxCell id="rel_gw_am" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=1;" parent="1" source="gateway" target="am" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_gw_im" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=1;" parent="1" source="gateway" target="im" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_gw_qm" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=1;" parent="1" source="gateway" target="qm" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- K8s → WAN -->
        <mxCell id="rel_im_wan" value="Upload to remote SE&lt;br&gt;[HTTPS, JWT]" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d79b00;strokeWidth=2;fontSize=9;" parent="1" source="im" target="wan" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_qm_wan" value="Download from remote SE&lt;br&gt;[HTTPS, JWT]" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d79b00;strokeWidth=2;fontSize=9;" parent="1" source="qm" target="wan" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_am_wan" value="Sync, Health check" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d79b00;strokeWidth=1.5;fontSize=9;dashed=1;" parent="1" source="am" target="wan" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="530" />
              <mxPoint x="1060" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- WAN → Remote SE -->
        <mxCell id="rel_wan_se1" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d79b00;strokeWidth=2;" parent="1" source="wan" target="se_remote1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_wan_se2" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d79b00;strokeWidth=2;" parent="1" source="wan" target="se_remote2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SE → Disks -->
        <mxCell id="rel_se1_disk" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;strokeWidth=1;" parent="1" source="se_remote1" target="disk1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_se2_disk" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;strokeWidth=1;" parent="1" source="se_remote2" target="disk2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- K8s internal -->
        <mxCell id="rel_am_pg" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;strokeWidth=1;" parent="1" source="am" target="postgresql" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_am_kc" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;strokeWidth=1;" parent="1" source="am" target="keycloak" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="710" />
              <mxPoint x="470" y="710" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== ЗАМЕТКИ ==================== -->

        <mxCell id="note_hybrid" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;Hybrid Deployment:&lt;/b&gt;&lt;br&gt;• Control plane (AM, IM, QM, PG, KC) в K8s&lt;br&gt;• SE как Docker containers в удалённых ЦОД&lt;br&gt;• Прямое подключение через WAN + TLS&lt;br&gt;• SE регистрируется в AM с external URL&lt;br&gt;• Все операции через JWT (SA tokens)&lt;br&gt;• Firewall: только порты SE (8010-8019)&lt;br&gt;• Гео-распределённое хранение данных&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="960" y="960" width="280" height="130" as="geometry" />
        </mxCell>

