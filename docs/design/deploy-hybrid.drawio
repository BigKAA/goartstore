        <mxCell id="se_remote2" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;SE (rw) #2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;Docker container&lt;br&gt;Port: 8010 (exposed)&lt;br&gt;Volume: /data (local SSD)&lt;br&gt;URL: se2.remote-dc.example.com&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="1280" y="650" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="disk2" value="&lt;b&gt;Local SSD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;1TB, /data&lt;br&gt;data + attr.json + WAL&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="1540" y="660" width="130" height="80" as="geometry" />
