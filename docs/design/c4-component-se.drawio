        <mxCell id="rel_file_attr" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=1;" parent="1" source="svc_file" target="attr_handler" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_repl_wal" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=1;" parent="1" source="svc_replication" target="wal" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="970" y="690" />
              <mxPoint x="220" y="690" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- GC, Reconcile connections -->
        <mxCell id="rel_gc_attr" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=1;" parent="1" source="gc" target="attr_handler" edge="1">
