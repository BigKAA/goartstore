        </mxCell>
        <mxCell id="rel_reconcile_attr" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=1;" parent="1" source="reconcile" target="attr_handler" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Storage Layer → File System -->
        <mxCell id="rel_wal_fs" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;strokeWidth=1.5;" parent="1" source="wal" target="ext_fs" edge="1">
