        <!-- dephealth -->
        <mxCell id="svc_dephealth" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;DepHealth&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333&quot;&gt;topologymetrics:&lt;br&gt;Keycloak JWKS, Storage FS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;arcSize=8;fontSize=10;" parent="1" vertex="1">
