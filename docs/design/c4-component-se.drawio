          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_gc_fs" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;strokeWidth=1.5;" parent="1" source="gc" target="ext_fs" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_reconcile_fs" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;strokeWidth=1.5;" parent="1" source="reconcile" target="ext_fs" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== ЗАМЕТКИ ==================== -->

        <mxCell id="note_modes" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;Режимы SE:&lt;/b&gt;&lt;br&gt;edit — черновики (TTL, GC)&lt;br&gt;rw — постоянное хранение&lt;br&gt;ro — только чтение&lt;br&gt;ar — архив (метаданные)&lt;br&gt;&lt;br&gt;&lt;b&gt;Переходы:&lt;/b&gt;&lt;br&gt;edit (locked) | rw→ro→ar&lt;br&gt;ro→rw (rollback, confirm)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="1300" y="890" width="180" height="160" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
