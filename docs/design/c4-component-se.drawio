          <mxGeometry x="100" y="900" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- ==================== ФАЙЛОВАЯ СИСТЕМА (внизу) ==================== -->

        <mxCell id="ext_fs" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Файловая система&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333&quot;&gt;NFS / PVC / Local Disk&lt;br&gt;&lt;br&gt;data/&lt;br&gt;├── {file_id}.data&lt;br&gt;├── {file_id}.attr.json&lt;br&gt;├── wal/&lt;br&gt;│   └── {timestamp}.wal&lt;br&gt;└── .lock (flock leader)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=middle;align=center;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="540" y="1060" width="280" height="200" as="geometry" />
        </mxCell>

        <!-- ==================== СВЯЗИ ==================== -->

        <!-- Внешние → HTTP Server -->
        <mxCell id="rel_im_http" value="Upload" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=9;" parent="1" source="ext_im" target="http_server" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_qm_http" value="Download" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=9;" parent="1" source="ext_qm" target="http_server" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_am_http" value="Sync, Files list" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=9;" parent="1" source="ext_am" target="http_server" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Keycloak → JWT -->
        <mxCell id="rel_kc_jwt" value="JWKS" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=9;" parent="1" source="ext_kc" target="jwt_middleware" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- HTTP Server → Handlers -->
        <mxCell id="rel_http_upload" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;" parent="1" source="http_server" target="handler_upload" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_http_download" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=1;exitX=0.4;exitY=1;exitDx=0;exitDy=0;" parent="1" source="http_server" target="handler_download" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_http_meta" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=1;exitX=0.6;exitY=1;exitDx=0;exitDy=0;" parent="1" source="http_server" target="handler_metadata" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_http_mode" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;" parent="1" source="http_server" target="handler_mode" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Handlers → Services -->
        <mxCell id="rel_h_upload_svc" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=1;" parent="1" source="handler_upload" target="svc_file" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_h_download_svc" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=1;" parent="1" source="handler_download" target="svc_file" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_h_meta_svc" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=1;" parent="1" source="handler_metadata" target="svc_file" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_h_mode_svc" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=1;" parent="1" source="handler_mode" target="svc_mode" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Services → Storage Layer -->
        <mxCell id="rel_file_wal" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=1;" parent="1" source="svc_file" target="wal" edge="1">
          <mxGeometry relative="1" as="geometry" />
