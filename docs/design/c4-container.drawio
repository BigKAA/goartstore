        <mxCell id="rel_m2m_gw" value="M2M API&lt;br&gt;[HTTPS, JWT]" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#d79b00;strokeWidth=1.5;fontSize=9;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" parent="1" source="person_m2m" target="gateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== СВЯЗИ: Gateway → Модули ==================== -->

        <mxCell id="rel_gw_am" value="/admin/*&lt;br&gt;/api/v1/*" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#9673a6;strokeWidth=1.5;fontSize=9;exitX=0.15;exitY=1;exitDx=0;exitDy=0;" parent="1" source="gateway" target="admin_module" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_gw_im" value="/upload/*" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#9673a6;strokeWidth=1.5;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="gateway" target="ingester_module" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_gw_qm" value="/query/*" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#9673a6;strokeWidth=1.5;fontSize=9;exitX=0.85;exitY=1;exitDx=0;exitDy=0;" parent="1" source="gateway" target="query_module" edge="1">
