          <mxGeometry x="100" y="480" width="280" height="150" as="geometry" />
        </mxCell>

        <!-- Ingester Module -->
        <mxCell id="ingester_module" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Ingester Module&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333&quot;&gt;[Go, chi, порт 8020]&lt;br&gt;&lt;br&gt;Загрузка файлов: приём,&lt;br&gt;буферизация, выбор SE&lt;br&gt;(Sequential Fill), регистрация&lt;br&gt;&lt;i&gt;Stateless&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;verticalAlign=middle;align=center;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="560" y="480" width="280" height="150" as="geometry" />
        </mxCell>

        <!-- Query Module -->
        <mxCell id="query_module" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Query Module&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333&quot;&gt;[Go, chi, порт 8030]&lt;br&gt;&lt;br&gt;Поиск (PostgreSQL FTS),&lt;br&gt;LRU кэш, proxy download&lt;br&gt;с поддержкой Range requests&lt;br&gt;&lt;i&gt;Stateless&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;verticalAlign=middle;align=center;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="1020" y="480" width="280" height="150" as="geometry" />
        </mxCell>

        <!-- ==================== STORAGE ELEMENTS ==================== -->

        <!-- SE в K8s -->
        <mxCell id="se_k8s" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Storage Element&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333&quot;&gt;[Go, chi, порт 8010]&lt;br&gt;&lt;br&gt;Физическое хранение файлов:&lt;br&gt;attr.json, WAL, GC, Reconcile&lt;br&gt;Режимы: edit / rw / ro / ar&lt;br&gt;&lt;i&gt;K8s StatefulSet + PVC&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;verticalAlign=middle;align=center;fontSize=11;" parent="1" vertex="1">
