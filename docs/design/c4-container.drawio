        <mxCell id="rel_dev_gw" value="REST API&lt;br&gt;[HTTPS, JWT]" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=9;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="person_developer" target="gateway" edge="1">
