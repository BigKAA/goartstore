        </mxCell>

        <!-- SE как Docker (удалённый) -->
        <mxCell id="se_docker" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Storage Element (Remote)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333&quot;&gt;[Go, chi, порт 8010]&lt;br&gt;&lt;br&gt;Удалённый узел хранения:&lt;br&gt;Docker контейнер в другом ЦОД,&lt;br&gt;WAN, TLS&lt;br&gt;&lt;i&gt;Docker Standalone&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;verticalAlign=middle;align=center;fontSize=11;strokeDashPattern=8 4;dashed=1;" parent="1" vertex="1">
