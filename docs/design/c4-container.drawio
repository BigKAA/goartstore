        <mxCell id="ext_keycloak" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Keycloak&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333&quot;&gt;[Identity Provider]&lt;br&gt;&lt;br&gt;OAuth 2.0 / OIDC&lt;br&gt;JWT RS256, JWKS&lt;br&gt;Realm: artstore&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;arcSize=8;verticalAlign=middle;align=center;fontSize=11;" parent="1" vertex="1">
