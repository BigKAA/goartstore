        </mxCell>

        <!-- ==================== СВЯЗИ: Модуль → Модуль ==================== -->

        <!-- IM → AM (SE list, file registration) -->
        <mxCell id="rel_im_am" value="GET /storage-elements&lt;br&gt;POST /files&lt;br&gt;[HTTP, SA JWT]" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#82b366;strokeWidth=1.5;fontSize=9;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="ingester_module" target="admin_module" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- QM → AM (file metadata, SE info) -->
        <mxCell id="rel_qm_am" value="GET /storage-elements/{id}&lt;br&gt;[HTTP, SA JWT]" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#82b366;strokeWidth=1.5;fontSize=9;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" parent="1" source="query_module" target="admin_module" edge="1">
