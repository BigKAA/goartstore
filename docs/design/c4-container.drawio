        <!-- QM → SE (download) -->
        <mxCell id="rel_qm_se_k8s" value="GET /files/{id}/download&lt;br&gt;[HTTP, SA JWT, streaming]" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#82b366;strokeWidth=1.5;fontSize=9;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" parent="1" source="query_module" target="se_k8s" edge="1">
          <mxGeometry relative="1" as="geometry" />
